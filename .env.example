# Consumed by docker-compose.yml via env_file: .env
# DATABASE_PATH is set directly in docker-compose.yml, not here.

SESSION_SECRET=            # openssl rand -base64 32
ADMIN_PASSWORD=            # what you'll type at /admin/login
SITE_URL=https://yourdomain.example   # used by RSS and OG tags

# Only needed if you run the cloudflared service from the same compose file.
# CLOUDFLARE_TUNNEL_TOKEN=
