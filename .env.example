# Consumed by docker-compose.yml via env_file: .env
# DATABASE_PATH is set directly in docker-compose.yml, not here.

SITE_URL=https://yourdomain.example   # used by RSS/OG tags and links in emails

# Read once by `node scripts/create-admin.mjs` to create (or reset) the one
# admin account — not read by the app itself at runtime. See README.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=             # at least 10 characters
ADMIN_NAME=admin            # what shows under your own comments

# EMAIL_PROVIDER=console just logs outgoing mail to the server's stdout —
# fine for local dev, but registration/reset links only really work with a
# real provider. See README's email section for the DNS setup Resend needs.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=greendal <no-reply@yourdomain.example>

# Only needed if you run the cloudflared service from the same compose file.
# CLOUDFLARE_TUNNEL_TOKEN=

# Authorizes calls to POST /api/newsletter/send — the weekly letter, fired
# by a scheduled task on the host, not by anything running inside the app.
# See README's "Weekly letter" section for how to set that up and generate
# a value here.
# NEWSLETTER_CRON_SECRET=
